+// The cached status needs its piece bitfield only for updateProgress(), which runs when num_pieces changes
+// (libtorrent then sends a fresh bitfield), and verified_pieces is never read: drop them for seeds instead of
+// holding copies for every torrent.
+void TorrentImpl::trimNativeStatus()
+{
+    m_nativeStatus.verified_pieces.clear();
+    if (hasMetadata() && (m_nativeStatus.num_pieces == m_torrentInfo.piecesCount()))
+        m_nativeStatus.pieces.clear();
+}
+
+void TorrentImpl::resetPieces()
+{
+    if (std::exchange(m_hasAllPieces, false))
+        m_pieces = QBitArray(m_torrentInfo.piecesCount(), false);
+    else
+        m_pieces.fill(false);
+}
+
+// Between resume data saves, a seed's "have" bitfield is only kept to re-add the torrent (reload()) or to
+// preserve progress, so it is stored as a flag and expanded when it is needed.
+void TorrentImpl::compactResumeProgress()
+{
+    lt::typed_bitfield<lt::piece_index_t> &havePieces = m_ltAddTorrentParams.have_pieces;
+    if (hasMetadata() && !havePieces.empty() && (havePieces.size() == m_torrentInfo.piecesCount())
+            && havePieces.all_set())
+    {
+        havePieces.clear();
+        m_resumeHasAllPieces = true;
+    }
+}
+
+void TorrentImpl::expandResumeProgress()
+{
+    if (std::exchange(m_resumeHasAllPieces, false))
+        m_ltAddTorrentParams.have_pieces.resize(m_torrentInfo.piecesCount(), true);
+}
+
 void TorrentImpl::setRatioLimit(qreal limit)
 {
     if (limit < USE_GLOBAL_RATIO)
