+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA  02110-1301, USA.
+ *
+ * In addition, as a special exception, the copyright holders give permission to
+ * link this program with the OpenSSL project's "OpenSSL" library (or with
+ * modified versions of it that use the same license as the "OpenSSL" library),
+ * and distribute the linked executables. You must obey the GNU General Public
+ * License in all respects for all of the code used other than "OpenSSL".  If you
+ * modify file(s), you may extend this exception to your version of the file(s),
+ * but you are not obligated to do so. If you do not wish to do so, delete this
+ * exception statement from your version.
+ */
+
+#pragma once
+
+#include <QByteArray>
+#include <QHash>
+#include <QString>
+#include <QStringList>
+#include <QVariant>
+
+// Writes compact JSON straight from the QVariant containers the WebAPI builds, without
+// converting them to QJsonObject/QJsonArray first. The output is what
+// QJsonDocument::fromVariant(...).toJson(QJsonDocument::Compact) produces for the same
+// data (same escaping and number formatting); only the order of QHash keys may differ.
+namespace JsonWriter
+{
+    void appendString(QByteArray &out, QStringView str);
+    void appendValue(QByteArray &out, const QVariant &value);
+    void appendMap(QByteArray &out, const QVariantMap &map);
+    void appendList(QByteArray &out, const QVariantList &list);
+    void appendStringList(QByteArray &out, const QStringList &list);
+
+    template <typename Value, typename Writer>
+    void appendHash(QByteArray &out, const QHash<QString, Value> &hash, Writer writeValue)
+    {
+        out.append('{');
+        bool first = true;
+        for (auto it = hash.cbegin(); it != hash.cend(); ++it)
+        {
+            if (!first)
+                out.append(',');
+            first = false;
+            appendString(out, it.key());
+            out.append(':');
+            writeValue(out, it.value());
+        }
+        out.append('}');
+    }
+
+    // Writes the members of one object: `{` on construction, `}` on destruction.
+    class ObjectWriter
+    {
+    public:
+        explicit ObjectWriter(QByteArray &out);
+        ~ObjectWriter();
+
+        // Writes the separator and `"key":`, then returns the buffer for the value.
+        QByteArray &key(QStringView name);
+
+    private:
+        Q_DISABLE_COPY_MOVE(ObjectWriter)
+
+        QByteArray &m_out;
+        bool m_first = true;
+    };
+}
