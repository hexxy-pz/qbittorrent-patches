+// Reads the "info" dictionary of a torrent's stored metadata. Called by libtorrent from any thread (mostly its
+// network thread, to verify a piece), so it uses its own read-only SQLite connection instead of Qt's, which are
+// bound to the thread that opened them. WAL mode lets it read while the worker writes.
+class BitTorrent::DBResumeDataStorage::InfoSectionReader
+{
+public:
+    InfoSectionReader(const Path &dbPath, const int bdecodeDepthLimit, const int bdecodeTokenLimit)
+        : m_dbPath {dbPath}
+        , m_bdecodeDepthLimit {bdecodeDepthLimit}
+        , m_bdecodeTokenLimit {bdecodeTokenLimit}
+    {
+    }
+
+    ~InfoSectionReader()
+    {
+        sqlite3_finalize(m_statement);
+        sqlite3_close(m_db);
+    }
+
+    std::vector<char> read(const lt::info_hash_t &infoHash)
+    {
+        const QByteArray torrentID = TorrentID::fromInfoHash(InfoHash(infoHash)).toString().toLatin1();
+
+        const std::lock_guard lock {m_mutex};
+        if (!m_statement && !open())
+            return {};
+
+        std::vector<char> infoSection;
+        sqlite3_bind_text(m_statement, 1, torrentID.constData(), static_cast<int>(torrentID.size()), SQLITE_TRANSIENT);
+        if (const int result = sqlite3_step(m_statement); result == SQLITE_ROW)
+        {
+            const auto *metadata = static_cast<const char *>(sqlite3_column_blob(m_statement, 0));
+            const int metadataSize = sqlite3_column_bytes(m_statement, 0);
+            lt::error_code ec;
+            const lt::bdecode_node root = lt::bdecode({metadata, metadataSize}, ec
+                    , nullptr, m_bdecodeDepthLimit, m_bdecodeTokenLimit);
+            if (const lt::bdecode_node info = (ec ? lt::bdecode_node() : root.dict_find_dict("info")))
+            {
+                const lt::span<const char> section = info.data_section();
+                infoSection.assign(section.begin(), section.end());
+            }
+            else
+            {
+                LogMsg(ResumeDataStorage::tr("Couldn't load piece hashes of torrent '%1': invalid metadata.")
+                        .arg(QString::fromLatin1(torrentID)), Log::CRITICAL);
+            }
+        }
+        else
+        {
+            LogMsg(ResumeDataStorage::tr("Couldn't load piece hashes of torrent '%1': %2")
+                    .arg(QString::fromLatin1(torrentID)
+                        , ((result == SQLITE_DONE) ? u"no metadata"_s : QString::fromUtf8(sqlite3_errmsg(m_db))))
+                    , Log::CRITICAL);
+        }
+        sqlite3_reset(m_statement);
+        sqlite3_clear_bindings(m_statement);
+        return infoSection;
+    }
+
+private:
+    bool open()
+    {
+        if (!m_db)
+        {
+            const QByteArray path = m_dbPath.toString().toUtf8();
+            if (sqlite3_open_v2(path.constData(), &m_db, SQLITE_OPEN_READONLY, nullptr) != SQLITE_OK)
+            {
+                LogMsg(ResumeDataStorage::tr("Couldn't open '%1' to load piece hashes: %2")
+                        .arg(m_dbPath.toString(), QString::fromUtf8(sqlite3_errmsg(m_db))), Log::CRITICAL);
+                sqlite3_close(m_db);
+                m_db = nullptr;
+                return false;
+            }
+            sqlite3_busy_timeout(m_db, 10'000);
+        }
+
+        const QByteArray statement = u"SELECT %1 FROM %2 WHERE %3 = ?1;"_s
+                .arg(quoted(DB_COLUMN_METADATA.name), quoted(DB_TABLE_TORRENTS), quoted(DB_COLUMN_TORRENT_ID.name)).toUtf8();
+        if (sqlite3_prepare_v2(m_db, statement.constData(), static_cast<int>(statement.size()), &m_statement, nullptr) != SQLITE_OK)
+        {
+            LogMsg(ResumeDataStorage::tr("Couldn't prepare loading piece hashes: %1")
+                    .arg(QString::fromUtf8(sqlite3_errmsg(m_db))), Log::CRITICAL);
+            m_statement = nullptr;
+            return false;
+        }
+        return true;
+    }
+
+    const Path m_dbPath;
+    const int m_bdecodeDepthLimit;
+    const int m_bdecodeTokenLimit;
+
+    std::mutex m_mutex;
+    sqlite3 *m_db = nullptr;
+    sqlite3_stmt *m_statement = nullptr;
+};
