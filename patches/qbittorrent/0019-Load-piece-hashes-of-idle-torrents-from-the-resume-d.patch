+// takes effect when the session starts (torrents are loaded with their hashes or without)
+bool SessionImpl::isPieceHashesOnDemandEnabled() const
+{
+    return m_isPieceHashesOnDemandEnabled;
+}
+
+void SessionImpl::setPieceHashesOnDemandEnabled(const bool enabled)
+{
+    m_isPieceHashesOnDemandEnabled = enabled;
+}
+
+int SessionImpl::pieceHashesIdleTime() const
+{
+    return m_pieceHashesIdleTime;
+}
+
+void SessionImpl::setPieceHashesIdleTime(const int minutes)
+{
+    m_pieceHashesIdleTime = std::max(1, minutes);
+}
+
+void SessionImpl::enablePieceHashesOnDemand(const DBResumeDataStorage *storage)
+{
+    m_infoSectionLoader = storage->infoSectionLoader();
+    connect(storage, &ResumeDataStorage::metadataStored, this, [this](const TorrentID &id)
+    {
+        if (TorrentImpl *torrent = m_torrents.value(id))
+            torrent->setMetadataStored();
+    });
+
+    m_pieceHashesReleaseTimer = new QTimer(this);
+    connect(m_pieceHashesReleaseTimer, &QTimer::timeout, this, &SessionImpl::releaseUnusedPieceHashes);
+    m_pieceHashesReleaseTimer->start(1min);
+
+    LogMsg(tr("Piece hashes of idle torrents are loaded from the resume data database when needed. Idle time: %1 minutes")
+            .arg(m_pieceHashesIdleTime.get()));
+}
+
+void SessionImpl::releaseUnusedPieceHashes()
+{
+    const std::chrono::minutes idleTime {m_pieceHashesIdleTime.get()};
+    int releasedCount = 0;
+    for (TorrentImpl *torrent : asConst(m_torrents))
+    {
+        if (torrent->releaseUnusedPieceHashes(idleTime))
+            ++releasedCount;
+    }
+    if (releasedCount > 0)
+        qDebug("Released the piece hashes of %d torrents", releasedCount);
+}
