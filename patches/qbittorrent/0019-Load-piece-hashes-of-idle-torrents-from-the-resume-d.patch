+    m_metadataStored = true;
+}
+
+bool TorrentImpl::releaseUnusedPieceHashes(const lt::time_duration idleTime) const
+{
+    if (!m_metadataStored || !hasMetadata())
+        return false;
+    if (isDownloading() || isChecking() || isMoving())
+        return false;
+
+    return m_torrentInfo.nativeInfo()->release_unused_piece_hashes(idleTime);
+}
