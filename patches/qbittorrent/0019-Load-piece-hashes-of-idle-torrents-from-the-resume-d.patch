+lt::info_section_loader BitTorrent::DBResumeDataStorage::infoSectionLoader() const
+{
+    if (!m_infoSectionReader)
+    {
+        const auto *pref = Preferences::instance();
+        m_infoSectionReader = std::make_shared<InfoSectionReader>(m_dbPath
+                , pref->getBdecodeDepthLimit(), pref->getBdecodeTokenLimit());
+    }
+
+    return [reader = m_infoSectionReader](const lt::info_hash_t &infoHash)
+    {
+        return reader->read(infoHash);
+    };
+}
