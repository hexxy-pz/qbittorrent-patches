From 6c7fb1302f6bf423ab329eab9c705ddda4713a72 Mon Sep 17 00:00:00 2001
From: Tom Piccirello <8296030+Piccirello@users.noreply.github.com>
Date: Sat, 28 Feb 2026 10:54:06 -0800
Subject: [PATCH 10/12] WebUI: Fix keyboard navigation when using virtual
 rendering

This change ensures up/down and left/right navigation continue working as the table is updated. It also fixes an issue where expanding/collapsing a folder wouldn't update the table until the next render, which was usually the next fetch.

PR #23865.

(cherry picked from commit c952b22b50bd482502fc00e3cb241acb4559c6f1)

Backport to 5.1.4: MooTools Class method syntax. expandFolder()/collapseFolder() passed
the node instead of its rowId to expandNode()/collapseNode() in 5.1.4; fixed as upstream.
---
 src/webui/www/private/scripts/dynamicTable.js | 21 +++++++++++++++----
 1 file changed, 17 insertions(+), 4 deletions(-)

diff --git a/src/webui/www/private/scripts/dynamicTable.js b/src/webui/www/private/scripts/dynamicTable.js
index 98049ce1d..cf6b06d29 100644
--- a/src/webui/www/private/scripts/dynamicTable.js
+++ b/src/webui/www/private/scripts/dynamicTable.js
@@ -952,6 +952,7 @@ window.qBittorrent.DynamicTable ??= (() => {
                     element = this.cachedElements[position] = this.createRowElement(row, offset);
                 elements.push(element);
             }
+            const hadFocus = this.dynamicTableDiv.contains(document.activeElement);
             this.tableBody.replaceChildren(...elements);
 
             // update row classes
@@ -960,6 +961,10 @@ window.qBittorrent.DynamicTable ??= (() => {
             // update visible rows
             for (const row of this.tableBody.children)
                 this.updateRow(row, true);
+
+            // restore focus so keyboard navigation continues working
+            if (hadFocus)
+                this.getTrByRowId(this.getSelectedRowId())?.focus({ preventScroll: true });
         },
 
         createRowElement: function(row, top = -1) {
@@ -1075,6 +1080,7 @@ window.qBittorrent.DynamicTable ??= (() => {
 
                 const newRow = visibleRows[selectedIndex + 1];
                 this.selectRow(newRow.getAttribute("data-row-id"));
+                newRow.focus({ preventScroll: true });
             }
         },
 
@@ -1097,6 +1103,7 @@ window.qBittorrent.DynamicTable ??= (() => {
 
                 const newRow = visibleRows[selectedIndex - 1];
                 this.selectRow(newRow.getAttribute("data-row-id"));
+                newRow.focus({ preventScroll: true });
             }
         },
     });
@@ -2688,14 +2695,20 @@ window.qBittorrent.DynamicTable ??= (() => {
 
         expandFolder: function(id) {
             const node = this.getNode(id);
-            if (node.isFolder)
-                this.expandNode(node);
+            if (node.isFolder) {
+                this.expandNode(node.rowId);
+                if (this.useVirtualList)
+                    this.rerender();
+            }
         },
 
         collapseFolder: function(id) {
             const node = this.getNode(id);
-            if (node.isFolder)
-                this.collapseNode(node);
+            if (node.isFolder) {
+                this.collapseNode(node.rowId);
+                if (this.useVirtualList)
+                    this.rerender();
+            }
         },
 
         isAllCheckboxesChecked: function() {
-- 
