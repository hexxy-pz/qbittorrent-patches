--- a/src/base/bittorrent/sessionimpl.cpp
+++ b/src/base/bittorrent/sessionimpl.cpp
@@ -5541,9 +5541,10 @@ void SessionImpl::setPieceHashesIdleTime(const int minutes)
     m_pieceHashesIdleTime = std::max(1, minutes);
