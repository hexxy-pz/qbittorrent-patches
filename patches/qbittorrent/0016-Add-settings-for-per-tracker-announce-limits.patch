+bool SessionImpl::isTrackerConnectionPoolEnabled() const
+{
+    return m_isTrackerConnectionPoolEnabled;
+}
+
+void SessionImpl::setTrackerConnectionPoolEnabled(const bool enabled)
+{
+    const bool v = enabled;
+    if (v == m_isTrackerConnectionPoolEnabled)
+        return;
+
+    m_isTrackerConnectionPoolEnabled = v;
+    configureDeferred();
+}
+
+bool SessionImpl::isTrackerHTTP2Enabled() const
