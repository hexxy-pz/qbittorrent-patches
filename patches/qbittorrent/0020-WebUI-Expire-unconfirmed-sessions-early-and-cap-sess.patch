--- a/src/base/preferences.cpp
+++ b/src/base/preferences.cpp
@@ -885,6 +885,46 @@ void Preferences::setWebUISessionTimeout(const int timeout)
     setValue(u"Preferences/WebUI/SessionTimeout"_s, timeout);
 }
 
+// how long a session lives until a request carries its cookie (capped by the session timeout)
+int Preferences::getWebUIProvisionalSessionTimeout() const
+{
+    return std::max(1, value<int>(u"Preferences/WebUI/ProvisionalSessionTimeout"_s, 60));
+}
+
+void Preferences::setWebUIProvisionalSessionTimeout(const int timeout)
+{
+    if (timeout == getWebUIProvisionalSessionTimeout())
+        return;
+
+    setValue(u"Preferences/WebUI/ProvisionalSessionTimeout"_s, std::max(1, timeout));
+}
+
+int Preferences::getWebUIMaxSessionsPerClient() const
+{
+    return std::max(1, value<int>(u"Preferences/WebUI/MaxSessionsPerClient"_s, 8));
+}
+
+void Preferences::setWebUIMaxSessionsPerClient(const int count)
+{
+    if (count == getWebUIMaxSessionsPerClient())
+        return;
+
+    setValue(u"Preferences/WebUI/MaxSessionsPerClient"_s, std::max(1, count));
+}
+
+int Preferences::getWebUIMaxSessions() const
+{
+    return std::max(1, value<int>(u"Preferences/WebUI/MaxSessions"_s, 32));
+}
+
+void Preferences::setWebUIMaxSessions(const int count)
+{
+    if (count == getWebUIMaxSessions())
+        return;
+
+    setValue(u"Preferences/WebUI/MaxSessions"_s, std::max(1, count));
+}
