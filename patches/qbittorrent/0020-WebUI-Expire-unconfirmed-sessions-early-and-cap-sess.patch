+// A new session is provisional until a request carries its cookie. Clients that do not keep cookies get a new
+// session with every request (under the authentication bypass), and each one held its API state (a full
+// sync/maindata snapshot after one call) for the whole session timeout. The session caps bound what clients
+// that do keep cookies can hold; provisional sessions are evicted first, then the least recently used.
+qint64 WebApplication::sessionTimeout(const WebSession *session) const
+{
+    if (session->isConfirmed())
+        return m_sessionTimeout;
+    return (m_sessionTimeout > 0)
+            ? std::min<qint64>(m_sessionTimeout, m_provisionalSessionTimeout) : m_provisionalSessionTimeout;
+}
+
+// removes the provisional session idle longest among those matching, or else the matching session idle longest
+void WebApplication::evictSession(const std::function<bool (const WebSession *)> &match)
+{
+    WebSession *victim = nullptr;
+    for (WebSession *session : asConst(m_sessions))
+    {
+        if (!match(session))
+            continue;
+        if (!victim || (std::make_pair(!session->isConfirmed(), session->idleTime())
+                > std::make_pair(!victim->isConfirmed(), victim->idleTime())))
+        {
+            victim = session;
+        }
+    }
+
+    Q_ASSERT(victim);
+    if (!victim) [[unlikely]]
+        return;
+
+    qDebug() << Q_FUNC_INFO << "evicting" << (victim->isConfirmed() ? "session" : "provisional session")
+             << "of" << victim->clientAddress().toString();
+    m_sessions.remove(victim->id());
+    delete victim;
+}
