+SyncController::TorrentDigest SyncController::makeTorrentDigest(const QVariantMap &serializedTorrent)
+{
+    TorrentDigest digest;
+    if (const QStringList keys = serializedTorrent.keys(); keys == m_torrentKeys)
+        digest.keys = m_torrentKeys;
+    else
+        digest.keys = m_torrentKeys = keys;
+
+    digest.valueHashes.reserve(serializedTorrent.size());
+    for (const QVariant &value : serializedTorrent)
+    {
+        m_valueBuffer.clear();
+        JsonWriter::appendValue(m_valueBuffer, value);
+        digest.valueHashes.append(jsonHash(m_valueBuffer));
+    }
+
+    return digest;
+}
+
+// Returns the fields of the torrent that changed since it was last processed (all of them for a new torrent).
+QVariantMap SyncController::processTorrent(const BitTorrent::TorrentID &torrentID, const QVariantMap &serializedTorrent)
+{
+    TorrentDigest digest = makeTorrentDigest(serializedTorrent);
+    TorrentDigest &prevDigest = m_torrentDigests[torrentID];
+    const bool sameKeys = (prevDigest.keys == digest.keys);
+
+    QVariantMap syncData;
+    qsizetype i = 0;
+    for (auto it = serializedTorrent.cbegin(); it != serializedTorrent.cend(); ++it, ++i)
+    {
+        quint64 prevHash = nullValueHash();
+        if (sameKeys)
+            prevHash = prevDigest.valueHashes[i];
+        else if (const qsizetype prevIndex = prevDigest.keys.indexOf(it.key()); prevIndex >= 0)
+            prevHash = prevDigest.valueHashes[prevIndex];
+
+        if (digest.valueHashes[i] != prevHash)
+            syncData.insert(it.key(), it.value());
+    }
+
+    prevDigest = std::move(digest);
+    return syncData;
+}
+
+// Writes every torrent as it is now and makes that what the client was last sent.
+void SyncController::appendAllTorrents(QByteArray &out)
+{
+    m_torrentDigests.clear();
+
+    JsonWriter::ObjectWriter torrentsObject {out};
+    for (const BitTorrent::Torrent *torrent : asConst(BitTorrent::Session::instance()->torrents()))
+    {
+        QVariantMap serializedTorrent = serialize(*torrent);
+        serializedTorrent.remove(KEY_TORRENT_ID);
+
+        m_torrentDigests.insert(torrent->id(), makeTorrentDigest(serializedTorrent));
+        JsonWriter::appendMap(torrentsObject.key(torrent->id().toString()), serializedTorrent);
+    }
+}
+
 // GET param:
 //   - hash (string): torrent hash (ID)
 //   - rid (int): last response id
