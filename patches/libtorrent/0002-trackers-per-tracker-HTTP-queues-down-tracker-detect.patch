--- /dev/null
+++ b/include/libtorrent/aux_/curl_tracker_transport.hpp
@@ -0,0 +1,103 @@
+/*
+
+You may use, distribute and modify this code under the terms of the BSD license,
+see LICENSE file.
+*/
+
+#ifndef TORRENT_CURL_TRACKER_TRANSPORT_HPP_INCLUDED
+#define TORRENT_CURL_TRACKER_TRANSPORT_HPP_INCLUDED
+
+#include "libtorrent/config.hpp"
+
+#if TORRENT_USE_CURL
+
+#include "libtorrent/address.hpp"
+#include "libtorrent/error_code.hpp"
+#include "libtorrent/io_context.hpp"
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace libtorrent {
+namespace aux {
+
+	// One HTTP(S) tracker request for curl_tracker_transport. Name resolution and endpoint
+	// filtering (SSRF mitigation, IP filter, listen socket routing) stay in
+	// http_tracker_connection; curl only connects to the addresses given here.
+	struct curl_tracker_request
+	{
+		std::string url;
+		std::string host;
+		int port = 0;
+		std::vector<address> addresses;
+		std::string user_agent;
+		// bind to this device and/or local address, like http_connection does
+		std::string bind_device;
+		address bind_address;
+		int timeout_ms = 30000;
+		int connect_timeout_ms = 10000;
+		bool verify_tls = true;
+		bool http2 = true;
+		// proxy URL for curl (socks4://, socks5://, socks5h://, http://host:port); "" = none,
+		// which also ignores proxies set in the environment
+		std::string proxy;
+		std::string proxy_username;
+		std::string proxy_password;
+		std::size_t max_response_size = 4 * 1024 * 1024;
+	};
+
+	struct curl_tracker_response
+	{
+		// set when no complete HTTP response was received
+		error_code ec;
+		std::string error_message;
+		int status = 0;
+		std::string reason;
+		// the header fields of the final response, "name: value\r\n" each
+		std::string headers;
+		std::vector<char> body;
+		// the address the request went to
+		address peer;
+		// 11 for HTTP/1.1, 20 for HTTP/2
+		int http_version = 0;
+		// true if the request reused an existing connection
+		bool reused = false;
+	};
+
+	// Runs libcurl's multi interface on libtorrent's network thread. Connections (and HTTP/2
+	// sessions) are pooled and reused per host; requests to one host can only queue behind
+	// requests to the same host (tracker_manager decides how many run at once per host).
+	struct TORRENT_EXTRA_EXPORT curl_tracker_transport
+	{
+		using handler_t = std::function<void(curl_tracker_response)>;
+
+		explicit curl_tracker_transport(io_context& ios);
+		~curl_tracker_transport();
+		curl_tracker_transport(curl_tracker_transport const&) = delete;
+		curl_tracker_transport& operator=(curl_tracker_transport const&) = delete;
+
+		// false if libcurl could not be initialized; callers fall back to http_connection
+		bool valid() const;
+
+		// starts the request; the handler is called exactly once, on the network thread,
+		// unless the request is cancelled first. Returns an id for cancel()
+		std::uint64_t perform(curl_tracker_request const& req, handler_t h);
+
+		// abort a request; its handler is not called
+		void cancel(std::uint64_t id);
+
+		// abort everything and drop all pooled connections
+		void close();
+
+		struct impl;
+	private:
+		std::shared_ptr<impl> m_impl;
+	};
+}
+}
+
+#endif // TORRENT_USE_CURL
+#endif
