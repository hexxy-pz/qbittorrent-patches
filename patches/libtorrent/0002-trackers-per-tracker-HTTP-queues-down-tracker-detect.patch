@@ -0,0 +1,413 @@
+/*
+
+You may use, distribute and modify this code under the terms of the BSD license,
+see LICENSE file.
+*/
+
+#include "libtorrent/config.hpp"
+
+#if TORRENT_USE_CURL
+
+#include "libtorrent/aux_/curl_tracker_transport.hpp"
+#include "libtorrent/error.hpp"
+#include "libtorrent/assert.hpp"
+
+#include "libtorrent/aux_/disable_warnings_push.hpp"
+#include <boost/asio/posix/stream_descriptor.hpp>
+#include <boost/asio/steady_timer.hpp>
+#include <boost/asio/post.hpp>
+#include <curl/curl.h>
+#include "libtorrent/aux_/disable_warnings_pop.hpp"
+
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+namespace libtorrent {
+namespace aux {
+
+namespace {
+
+	error_code map_curl_error(CURLcode const c)
+	{
+		switch (c)
+		{
+			case CURLE_OPERATION_TIMEDOUT: return errors::timed_out;
+			case CURLE_COULDNT_RESOLVE_HOST:
+			case CURLE_COULDNT_RESOLVE_PROXY: return boost::asio::error::host_not_found;
+			case CURLE_COULDNT_CONNECT: return boost::asio::error::connection_refused;
+			// the proxy refused or could not reach the tracker (the message says which)
+			case CURLE_PROXY: return boost::asio::error::network_unreachable;
+			case CURLE_GOT_NOTHING:
+			case CURLE_PARTIAL_FILE:
+			case CURLE_RECV_ERROR: return boost::asio::error::eof;
+			case CURLE_SEND_ERROR: return boost::asio::error::connection_reset;
+			case CURLE_WRITE_ERROR:
+			case CURLE_FILESIZE_EXCEEDED: return boost::asio::error::message_size;
+			case CURLE_SSL_CONNECT_ERROR:
+			case CURLE_PEER_FAILED_VERIFICATION:
+			case CURLE_SSL_CERTPROBLEM:
+			case CURLE_SSL_CIPHER:
+			case CURLE_SSL_CACERT_BADFILE:
+			case CURLE_SSL_ISSUER_ERROR: return boost::asio::error::no_protocol_option;
+			default: return boost::asio::error::fault;
+		}
+	}
+
+	std::once_flag curl_init_once;
+	bool curl_init_ok = false;
+}
+
+	struct curl_tracker_transport::impl : std::enable_shared_from_this<impl>
+	{
+		explicit impl(io_context& ios) : m_ios(ios), m_timer(ios) {}
+
+		struct request
+		{
+			std::uint64_t id = 0;
+			CURL* easy = nullptr;
+			curl_slist* resolve = nullptr;
+			curl_slist* headers = nullptr;
+			handler_t handler;
+			curl_tracker_response response;
+			std::size_t max_size = 0;
+			char error_buf[CURL_ERROR_SIZE] = {};
+		};
+
+		struct watch
+		{
+			explicit watch(io_context& ios) : desc(ios) {}
+			boost::asio::posix::stream_descriptor desc;
+			int what = 0;
+			bool reading = false;
+			bool writing = false;
+			std::uint64_t generation = 0;
+		};
+
+		bool init()
+		{
+			std::call_once(curl_init_once, [] { curl_init_ok = curl_global_init(CURL_GLOBAL_DEFAULT) == CURLE_OK; });
+			if (!curl_init_ok) return false;
+			m_multi = curl_multi_init();
+			if (m_multi == nullptr) return false;
+			curl_multi_setopt(m_multi, CURLMOPT_SOCKETFUNCTION, &impl::socket_cb);
+			curl_multi_setopt(m_multi, CURLMOPT_SOCKETDATA, this);
+			curl_multi_setopt(m_multi, CURLMOPT_TIMERFUNCTION, &impl::timer_cb);
+			curl_multi_setopt(m_multi, CURLMOPT_TIMERDATA, this);
+			// multiplex HTTP/2 streams over one connection per host; HTTP/1.1 connections
+			// are kept alive and reused one request at a time
+			curl_multi_setopt(m_multi, CURLMOPT_PIPELINING, long(CURLPIPE_MULTIPLEX));
+			curl_multi_setopt(m_multi, CURLMOPT_MAX_CONCURRENT_STREAMS, 100L);
+			// size of the idle connection cache (across all trackers)
+			curl_multi_setopt(m_multi, CURLMOPT_MAXCONNECTS, 512L);
+			return true;
+		}
+
+		~impl()
+		{
+			close();
+			if (m_multi) curl_multi_cleanup(m_multi);
+		}
+
+		std::uint64_t perform(curl_tracker_request const& r, handler_t h)
+		{
+			auto req = std::make_unique<request>();
+			req->id = ++m_next_id;
+			req->handler = std::move(h);
+			req->max_size = r.max_response_size;
+			CURL* e = curl_easy_init();
+			if (e == nullptr)
+			{
+				curl_tracker_response resp;
+				resp.ec = boost::asio::error::no_memory;
+				resp.error_message = "curl_easy_init failed";
+				boost::asio::post(m_ios, [hh = std::move(req->handler), resp]() mutable { hh(std::move(resp)); });
+				return 0;
+			}
+			req->easy = e;
+
+			// connect only to the addresses libtorrent resolved and filtered
+			std::string pin = r.host + ":" + std::to_string(r.port) + ":";
+			for (std::size_t i = 0; i < r.addresses.size(); ++i)
+			{
+				if (i > 0) pin += ",";
+				pin += r.addresses[i].is_v6() ? "[" + r.addresses[i].to_string() + "]" : r.addresses[i].to_string();
+			}
+			// a literal IP in the URL needs no pinning
+			if (!r.addresses.empty()) req->resolve = curl_slist_append(nullptr, pin.c_str());
+			// same request headers as http_connection (minus "Connection: close"): no "Accept"
+			req->headers = curl_slist_append(nullptr, "Accept:");
+
+			curl_easy_setopt(e, CURLOPT_URL, r.url.c_str());
+			if (req->resolve) curl_easy_setopt(e, CURLOPT_RESOLVE, req->resolve);
+			curl_easy_setopt(e, CURLOPT_HTTPHEADER, req->headers);
+			curl_easy_setopt(e, CURLOPT_PROTOCOLS_STR, "http,https");
+			curl_easy_setopt(e, CURLOPT_FOLLOWLOCATION, 0L);
+			curl_easy_setopt(e, CURLOPT_NOSIGNAL, 1L);
+			curl_easy_setopt(e, CURLOPT_ACCEPT_ENCODING, "gzip");
+			if (!r.user_agent.empty()) curl_easy_setopt(e, CURLOPT_USERAGENT, r.user_agent.c_str());
+			curl_easy_setopt(e, CURLOPT_HTTP_VERSION, r.http2 ? long(CURL_HTTP_VERSION_2TLS) : long(CURL_HTTP_VERSION_1_1));
+			// wait for an HTTP/2 connection that is being set up rather than opening another one
+			if (r.http2) curl_easy_setopt(e, CURLOPT_PIPEWAIT, 1L);
+			curl_easy_setopt(e, CURLOPT_TIMEOUT_MS, long(r.timeout_ms));
+			curl_easy_setopt(e, CURLOPT_CONNECTTIMEOUT_MS, long(std::min(r.timeout_ms, r.connect_timeout_ms)));
+			curl_easy_setopt(e, CURLOPT_MAXAGE_CONN, 120L);
+			curl_easy_setopt(e, CURLOPT_SSL_VERIFYPEER, r.verify_tls ? 1L : 0L);
+			curl_easy_setopt(e, CURLOPT_SSL_VERIFYHOST, r.verify_tls ? 2L : 0L);
+			// connections are cached per proxy, so a proxy change never reuses one made without it
+			curl_easy_setopt(e, CURLOPT_PROXY, r.proxy.c_str());
+			if (!r.proxy.empty() && !r.proxy_username.empty())
+			{
+				curl_easy_setopt(e, CURLOPT_PROXYUSERNAME, r.proxy_username.c_str());
+				curl_easy_setopt(e, CURLOPT_PROXYPASSWORD, r.proxy_password.c_str());
+			}
+			std::string iface;
+			if (!r.bind_device.empty()) iface = "if!" + r.bind_device;
+			else if (!r.bind_address.is_unspecified()) iface = "host!" + r.bind_address.to_string();
+			if (!iface.empty()) curl_easy_setopt(e, CURLOPT_INTERFACE, iface.c_str());
+			curl_easy_setopt(e, CURLOPT_HEADERFUNCTION, &impl::header_cb);
+			curl_easy_setopt(e, CURLOPT_HEADERDATA, req.get());
+			curl_easy_setopt(e, CURLOPT_WRITEFUNCTION, &impl::write_cb);
+			curl_easy_setopt(e, CURLOPT_WRITEDATA, req.get());
+			curl_easy_setopt(e, CURLOPT_ERRORBUFFER, req->error_buf);
+			curl_easy_setopt(e, CURLOPT_PRIVATE, req.get());
+
+			std::uint64_t const id = req->id;
+			m_requests.emplace(id, std::move(req));
+			if (curl_multi_add_handle(m_multi, e) != CURLM_OK)
+			{
+				auto it = m_requests.find(id);
+				curl_tracker_response resp;
+				resp.ec = boost::asio::error::fault;
+				resp.error_message = "curl_multi_add_handle failed";
+				handler_t hh = std::move(it->second->handler);
+				destroy(*it->second, false);
+				m_requests.erase(it);
+				boost::asio::post(m_ios, [hh = std::move(hh), resp]() mutable { hh(std::move(resp)); });
+				return 0;
+			}
+			return id;
+		}
+
+		void cancel(std::uint64_t const id)
+		{
+			auto it = m_requests.find(id);
+			if (it == m_requests.end()) return;
+			destroy(*it->second, true);
+			m_requests.erase(it);
+		}
+
+		void close()
+		{
+			for (auto& r : m_requests) destroy(*r.second, true);
+			m_requests.clear();
+			m_timer.cancel();
+		}
+
+		void destroy(request& r, bool const in_multi)
+		{
+			if (r.easy)
+			{
+				if (in_multi) curl_multi_remove_handle(m_multi, r.easy);
+				curl_easy_cleanup(r.easy);
+				r.easy = nullptr;
+			}
+			curl_slist_free_all(r.resolve);
+			curl_slist_free_all(r.headers);
+			r.resolve = r.headers = nullptr;
+		}
+
+		static size_t header_cb(char* data, size_t size, size_t n, void* userp)
+		{
+			auto* r = static_cast<request*>(userp);
+			std::string line(data, size * n);
+			// a new status line starts the headers of the next (final) response
+			if (line.compare(0, 5, "HTTP/") == 0)
+			{
+				r->response.headers.clear();
+				auto const sp1 = line.find(' ');
+				auto const sp2 = sp1 == std::string::npos ? sp1 : line.find(' ', sp1 + 1);
+				r->response.reason = sp2 == std::string::npos ? std::string()
+					: line.substr(sp2 + 1, line.find_last_not_of("\r\n") - sp2);
+				return size * n;
+			}
+			if (line != "\r\n" && line != "\n") r->response.headers += line;
+			return size * n;
+		}
+
+		static size_t write_cb(char* data, size_t size, size_t n, void* userp)
+		{
+			auto* r = static_cast<request*>(userp);
+			if (r->response.body.size() + size * n > r->max_size) return 0;
+			r->response.body.insert(r->response.body.end(), data, data + size * n);
+			return size * n;
+		}
+
+		static int timer_cb(CURLM*, long const timeout_ms, void* userp)
+		{
+			auto* self = static_cast<impl*>(userp);
+			self->m_timer.cancel();
+			if (timeout_ms < 0) return 0;
+			// also called from curl_multi_remove_handle() while ~impl runs: no shared_from_this()
+			std::weak_ptr<impl> weak = self->weak_from_this();
+			if (weak.expired()) return 0;
+			self->m_timer.expires_after(std::chrono::milliseconds(timeout_ms));
+			self->m_timer.async_wait([weak](error_code const& ec)
+			{
+				if (ec) return;
+				auto s = weak.lock();
+				if (!s) return;
+				int running = 0;
+				curl_multi_socket_action(s->m_multi, CURL_SOCKET_TIMEOUT, 0, &running);
+				s->check_done();
+			});
+			return 0;
+		}
+
+		static int socket_cb(CURL*, curl_socket_t const fd, int const what, void* userp, void*)
+		{
+			auto* self = static_cast<impl*>(userp);
+			if (what == CURL_POLL_REMOVE)
+			{
+				auto it = self->m_watches.find(fd);
+				if (it != self->m_watches.end())
+				{
+					error_code ec;
+					it->second->desc.cancel(ec);
+					// the descriptor belongs to curl: release, never close
+					it->second->desc.release();
+					self->m_watches.erase(it);
+				}
+				return 0;
+			}
+			auto it = self->m_watches.find(fd);
+			if (it == self->m_watches.end())
+			{
+				auto w = std::make_unique<watch>(self->m_ios);
+				error_code ec;
+				w->desc.assign(fd, ec);
+				if (ec) return -1;
+				w->generation = ++self->m_generation;
+				it = self->m_watches.emplace(fd, std::move(w)).first;
+			}
+			it->second->what = what;
+			self->arm(fd, *it->second);
+			return 0;
+		}
+
+		void arm(curl_socket_t const fd, watch& w)
+		{
+			std::weak_ptr<impl> weak = weak_from_this();
+			std::uint64_t const gen = w.generation;
+			if ((w.what & CURL_POLL_IN) && !w.reading)
+			{
+				w.reading = true;
+				w.desc.async_wait(boost::asio::posix::stream_descriptor::wait_read
+					, [weak, fd, gen](error_code const& ec) { if (auto s = weak.lock()) s->on_ready(fd, gen, CURL_CSELECT_IN, ec); });
+			}
+			if ((w.what & CURL_POLL_OUT) && !w.writing)
+			{
+				w.writing = true;
+				w.desc.async_wait(boost::asio::posix::stream_descriptor::wait_write
+					, [weak, fd, gen](error_code const& ec) { if (auto s = weak.lock()) s->on_ready(fd, gen, CURL_CSELECT_OUT, ec); });
+			}
+		}
+
+		void on_ready(curl_socket_t const fd, std::uint64_t const gen, int const dir, error_code const& ec)
+		{
+			auto it = m_watches.find(fd);
+			if (it == m_watches.end() || it->second->generation != gen) return;
+			if (dir == CURL_CSELECT_IN) it->second->reading = false;
+			else it->second->writing = false;
+			if (ec == boost::asio::error::operation_aborted) return;
+			// curl may have switched direction since this wait was armed
+			if (!ec && !(it->second->what & (dir == CURL_CSELECT_IN ? CURL_POLL_IN : CURL_POLL_OUT))) return;
+			int running = 0;
+			curl_multi_socket_action(m_multi, fd, ec ? CURL_CSELECT_ERR : dir, &running);
+			check_done();
+			// still interested in this socket: wait again
+			it = m_watches.find(fd);
+			if (it != m_watches.end() && it->second->generation == gen) arm(fd, *it->second);
+		}
+
+		void check_done()
+		{
+			std::vector<std::pair<handler_t, curl_tracker_response>> done;
+			int left = 0;
+			while (CURLMsg* msg = curl_multi_info_read(m_multi, &left))
+			{
+				if (msg->msg != CURLMSG_DONE) continue;
+				char* priv = nullptr;
+				curl_easy_getinfo(msg->easy_handle, CURLINFO_PRIVATE, &priv);
+				auto* r = reinterpret_cast<request*>(priv);
+				if (r == nullptr) continue;
+				auto it = m_requests.find(r->id);
+				if (it == m_requests.end()) continue;
+				curl_tracker_response& resp = r->response;
+				CURLcode const res = msg->data.result;
+				long code = 0, version = 0, connects = 0;
+				char* ip = nullptr;
+				curl_easy_getinfo(r->easy, CURLINFO_RESPONSE_CODE, &code);
+				curl_easy_getinfo(r->easy, CURLINFO_HTTP_VERSION, &version);
+				curl_easy_getinfo(r->easy, CURLINFO_NUM_CONNECTS, &connects);
+				curl_easy_getinfo(r->easy, CURLINFO_PRIMARY_IP, &ip);
+				resp.status = int(code);
+				resp.http_version = version == CURL_HTTP_VERSION_2_0 ? 20 : version == CURL_HTTP_VERSION_1_0 ? 10 : 11;
+				resp.reused = connects == 0;
+				if (ip && *ip)
+				{
+					error_code aec;
+					resp.peer = make_address(ip, aec);
+				}
+				if (res != CURLE_OK)
+				{
+					resp.ec = map_curl_error(res);
+					resp.error_message = std::string("curl: ") + (r->error_buf[0] ? r->error_buf : curl_easy_strerror(res));
+				}
+				done.emplace_back(std::move(r->handler), std::move(resp));
+				destroy(*r, true);
+				m_requests.erase(it);
+			}
+			// handlers may start new requests or cancel others
+			for (auto& d : done) d.first(std::move(d.second));
+		}
+
+		io_context& m_ios;
+		CURLM* m_multi = nullptr;
+		boost::asio::steady_timer m_timer;
+		std::unordered_map<std::uint64_t, std::unique_ptr<request>> m_requests;
+		std::unordered_map<curl_socket_t, std::unique_ptr<watch>> m_watches;
+		std::uint64_t m_next_id = 0;
+		std::uint64_t m_generation = 0;
+	};
+
+	curl_tracker_transport::curl_tracker_transport(io_context& ios)
+		: m_impl(std::make_shared<impl>(ios))
+	{
+		if (!m_impl->init()) m_impl.reset();
+	}
+
+	curl_tracker_transport::~curl_tracker_transport() = default;
+
+	bool curl_tracker_transport::valid() const { return bool(m_impl); }
+
+	std::uint64_t curl_tracker_transport::perform(curl_tracker_request const& req, handler_t h)
+	{
+		TORRENT_ASSERT(m_impl);
+		return m_impl->perform(req, std::move(h));
+	}
+
+	void curl_tracker_transport::cancel(std::uint64_t const id)
+	{
+		if (m_impl && id != 0) m_impl->cancel(id);
+	}
+
+	void curl_tracker_transport::close()
+	{
+		if (m_impl) m_impl->close();
+	}
+}
+}
