+TORRENT_TEST(piece_hashes_on_demand)
+{
+	std::vector<char> const buf = make_v1_torrent(5);
+	torrent_info const orig(buf, from_span);
+	std::vector<char> const section = copy_section(orig);
+
+	torrent_info ti(buf, from_span);
+	int loads = 0;
+	TEST_CHECK(ti.load_piece_hashes_on_demand([&](info_hash_t const& ih) {
+		TEST_CHECK(ih == orig.info_hashes());
+		++loads;
+		return section;
+	}, false));
+	TEST_CHECK(!ti.piece_hashes_loaded());
+	TEST_EQUAL(loads, 0);
+
+	// everything that does not need the hashes works without loading them
+	TEST_EQUAL(ti.num_files(), orig.num_files());
+	for (auto const f : orig.files().file_range())
+		TEST_EQUAL(ti.files().file_path(f), orig.files().file_path(f));
+	TEST_EQUAL(ti.name(), orig.name());
+	TEST_CHECK(ti.info_hashes() == orig.info_hashes());
+#ifndef TORRENT_DISABLE_MUTABLE_TORRENTS
+	TEST_CHECK(ti.similar_torrents() == orig.similar_torrents());
+	TEST_CHECK(ti.collections() == orig.collections());
+#endif
+	TEST_CHECK(ti.info("name"));
+	TEST_EQUAL(loads, 0);
+
+	for (auto const p : orig.piece_range())
+		TEST_EQUAL(ti.hash_for_piece(p), orig.hash_for_piece(p));
+	TEST_EQUAL(loads, 1);
+	TEST_CHECK(ti.piece_hashes_loaded());
+	TEST_CHECK(copy_section(ti) == section);
+	TEST_EQUAL(sha1_hash(ti.hash_for_piece_ptr(piece_index_t(2))), orig.hash_for_piece(piece_index_t(2)));
+	TEST_EQUAL(loads, 1);
+
+	// copies share the loaded hashes
+	torrent_info const copy(ti);
+	TEST_CHECK(copy.piece_hashes_loaded());
+
+	// not idle long enough
+	TEST_CHECK(!ti.release_unused_piece_hashes(lt::seconds(60)));
+	TEST_CHECK(ti.release_unused_piece_hashes(lt::seconds(0)));
+	TEST_CHECK(!ti.piece_hashes_loaded());
+	TEST_CHECK(!copy.piece_hashes_loaded());
+	TEST_CHECK(!ti.release_unused_piece_hashes(lt::seconds(0)));
+
+	TEST_EQUAL(copy.hash_for_piece(piece_index_t(1)), orig.hash_for_piece(piece_index_t(1)));
+	TEST_EQUAL(loads, 2);
+	TEST_CHECK(ti.piece_hashes_loaded());
+
+	// can only be done once
+	TEST_CHECK(!ti.load_piece_hashes_on_demand([&](info_hash_t const&) { return section; }, false));
+}
+
+TORRENT_TEST(piece_hashes_on_demand_keep_loaded)
+{
+	std::vector<char> const buf = make_v1_torrent(1);
+	torrent_info const orig(buf, from_span);
+	torrent_info ti(buf, from_span);
+	int loads = 0;
+	TEST_CHECK(ti.load_piece_hashes_on_demand([&](info_hash_t const&) {
+		++loads;
+		return std::vector<char>();
+	}, true));
+	TEST_CHECK(ti.piece_hashes_loaded());
+	TEST_CHECK(copy_section(ti) == copy_section(orig));
+	TEST_EQUAL(ti.hash_for_piece(piece_index_t(0)), orig.hash_for_piece(piece_index_t(0)));
+	TEST_EQUAL(loads, 0);
+	TEST_CHECK(ti.release_unused_piece_hashes(lt::seconds(0)));
+	TEST_EQUAL(ti.name(), orig.name());
+}
+
+TORRENT_TEST(piece_hashes_on_demand_bad_loader)
+{
+	std::vector<char> const buf = make_v1_torrent(2);
+	torrent_info const orig(buf, from_span);
+	std::vector<char> wrong = copy_section(orig);
+	// same size, different content: fails the info-hash check
+	wrong[wrong.size() - 30] ^= 1;
+
+	for (auto const& result : {std::vector<char>(), wrong})
+	{
+		torrent_info ti(buf, from_span);
+		TEST_CHECK(ti.load_piece_hashes_on_demand([&](info_hash_t const&) { return result; }, false));
+		TEST_THROW(ti.hash_for_piece(piece_index_t(0)));
+		TEST_THROW(ti.info_section());
+		TEST_CHECK(!ti.piece_hashes_loaded());
+	}
+}
+
+TORRENT_TEST(piece_hashes_on_demand_v2_unsupported)
+{
+	auto const loader = [](info_hash_t const&) { return std::vector<char>(); };
+	{
+		torrent_info ti(combine_path(parent_path(current_working_directory())
+			, combine_path("test_torrents", "v2_hybrid.torrent")));
+		TEST_CHECK(ti.info_hashes().has_v2());
+		TEST_CHECK(!ti.load_piece_hashes_on_demand(loader, false));
+		TEST_CHECK(ti.piece_hashes_loaded());
+	}
+	{
+		torrent_info ti(make_v1_torrent(2), from_span);
+		TEST_CHECK(!ti.load_piece_hashes_on_demand(info_section_loader(), false));
+	}
+}
+
+TORRENT_TEST(piece_hashes_on_demand_backoff)
+{
+	std::vector<char> const buf = make_v1_torrent(1);
+	torrent_info const orig(buf, from_span);
+	std::vector<char> const section = copy_section(orig);
+	torrent_info ti(buf, from_span);
+	TEST_CHECK(ti.load_piece_hashes_on_demand([&](info_hash_t const&) { return section; }, false));
+
+	// hashes used within the idle time are kept
+	ti.hash_for_piece(piece_index_t(0));
+	TEST_CHECK(!ti.release_unused_piece_hashes(lt::hours(1)));
+
+	// a release with no idle time is never premature, so reloading right away
+	// does not back off: repeated cycles keep releasing
+	for (int i = 0; i < 8; ++i)
+	{
+		TEST_CHECK(ti.release_unused_piece_hashes(lt::seconds(0)));
+		TEST_EQUAL(ti.hash_for_piece(piece_index_t(0)), orig.hash_for_piece(piece_index_t(0)));
+	}
+
+	// released after 50 ms of idle time and needed again right away: the next
+	// release needs at least 100 ms
+	std::this_thread::sleep_for(lt::milliseconds(60));
+	TEST_CHECK(ti.release_unused_piece_hashes(lt::milliseconds(50)));
+	ti.hash_for_piece(piece_index_t(0));
+	std::this_thread::sleep_for(lt::milliseconds(60));
+	TEST_CHECK(!ti.release_unused_piece_hashes(lt::milliseconds(50)));
+	std::this_thread::sleep_for(lt::milliseconds(60));
+	TEST_CHECK(ti.release_unused_piece_hashes(lt::milliseconds(50)));
+}
+
+TORRENT_TEST(piece_hashes_on_demand_size)
+{
+	std::vector<char> const buf = make_v1_torrent(3);
+	torrent_info const orig(buf, from_span);
+	torrent_info ti(buf, from_span);
+	TEST_CHECK(ti.load_piece_hashes_on_demand([](info_hash_t const&) { return std::vector<char>(); }, false));
+	TEST_EQUAL(ti.info_section_size(), int(orig.info_section().size()));
+	TEST_EQUAL(orig.info_section_size(), int(orig.info_section().size()));
+	TEST_CHECK(!ti.piece_hashes_loaded());
+}
