 	{
-		boost::shared_array<char> ret(new char[std::size_t(m_info_section_size)]);
-		std::memcpy(ret.get(), m_info_section.get(), std::size_t(m_info_section_size));
+		span<char const> const section = info_section();
+		boost::shared_array<char> ret(new char[std::size_t(section.size())]);
+		std::memcpy(ret.get(), section.data(), std::size_t(section.size()));
 		return ret;
 	}
 #endif
@@ -1901,6 +2071,7 @@ namespace {
 		}
 
 		TORRENT_ASSERT(m_piece_hashes <= m_info_section_size);
+		TORRENT_ASSERT(!m_hash_store || m_piece_hashes == 0);
