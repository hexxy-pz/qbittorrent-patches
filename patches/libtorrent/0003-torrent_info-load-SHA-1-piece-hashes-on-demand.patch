+	bool file_storage::rebase_borrowed_pointers(char const* const old_begin
+		, char const* const old_end, int const size, char const* const new_begin)
+	{
+		char const* const keep_end = old_begin + size;
+		auto const movable = [=](char const* p)
+		{ return p == nullptr || p < old_begin || p >= old_end || p < keep_end; };
+		auto const rebase = [=](char const*& p)
+		{ if (p != nullptr && p >= old_begin && p < keep_end) p = new_begin + (p - old_begin); };
+
+		for (auto const& f : m_files)
+		{
+			if (f.name_len != aux::file_entry::name_is_owned && !movable(f.name)) return false;
+			if (!movable(f.root)) return false;
+		}
+		for (char const* h : m_file_hashes)
+			if (!movable(h)) return false;
+
+		for (auto& f : m_files)
+		{
+			if (f.name_len != aux::file_entry::name_is_owned) rebase(f.name);
+			rebase(f.root);
+		}
+		for (char const*& h : m_file_hashes) rebase(h);
+		return true;
+	}
