+	// the full info section of a torrent_info whose piece hashes are loaded on
+	// demand, see torrent_info::load_piece_hashes_on_demand()
+	struct piece_hash_store
+	{
+		piece_hash_store(info_section_loader l, info_hash_t const& ih
+			, int const size_, int const hashes_, int const num_pieces_)
+			: loader(std::move(l)), info_hash(ih), size(size_), hashes(hashes_)
+			, num_pieces(num_pieces_)
+		{}
+
+		// returns the loaded info section. The caller holds the mutex
+		char const* load()
+		{
+			last_used = clock_type::now();
+			if (section) return section.get();
+
+			// needed again within the idle time it was released after: that was
+			// too early, so wait longer next time. A late reload shortens it again.
+			if (released_at != time_point() && last_used - released_at < released_idle)
+				backoff = std::min(backoff + 1, max_backoff);
+			else if (backoff > 0)
+				--backoff;
+
+			std::vector<char> buf = loader(info_hash);
+			if (int(buf.size()) != size
+				|| hasher(buf).final() != info_hash.v1)
+			{
+				aux::throw_ex<system_error>(errors::no_metadata);
+			}
+			section.reset(new char[std::size_t(size)]);
+			std::memcpy(section.get(), buf.data(), std::size_t(size));
+			return section.get();
+		}
+
+		info_section_loader const loader;
+		info_hash_t const info_hash;
+		// the number of bytes in the full info section
+		int const size;
+		// the offset of the first piece hash in it
+		int const hashes;
+		int const num_pieces;
+
+		std::mutex mutex;
+		// the full info section, or null while it is released
+		boost::shared_array<char> section;
+		// the section released last, freed by the next release call: pointers
+		// handed out by hash_for_piece_ptr() and info_section() (to other threads,
+		// too) stay valid until then
+		boost::shared_array<char> retired;
+		time_point last_used;
+
+		// the idle time passed to release_unused_piece_hashes() is doubled this
+		// many times (premature releases), up to 16 times
+		static constexpr int max_backoff = 4;
+		int backoff = 0;
+		time_point released_at;
+		time_duration released_idle{};
+	};
+}
+
 	sha1_hash torrent_info::hash_for_piece(piece_index_t const index) const
-	{ return sha1_hash(hash_for_piece_ptr(index)); }
+	{
+		if (m_hash_store)
+		{
+			std::lock_guard<std::mutex> l(m_hash_store->mutex);
+			return sha1_hash(m_hash_store->load() + m_hash_store->hashes
+				+ static_cast<int>(index) * 20);
+		}
+		return sha1_hash(hash_for_piece_ptr(index));
+	}
+
+	char const* torrent_info::loaded_hash_for_piece_ptr(piece_index_t const index) const
+	{
+		TORRENT_ASSERT_PRECOND(index >= piece_index_t(0));
+		TORRENT_ASSERT_PRECOND(static_cast<int>(index) < m_hash_store->num_pieces);
+		std::lock_guard<std::mutex> l(m_hash_store->mutex);
+		return m_hash_store->load() + m_hash_store->hashes + static_cast<int>(index) * 20;
+	}
+
+	span<char const> torrent_info::loaded_info_section() const
+	{
+		std::lock_guard<std::mutex> l(m_hash_store->mutex);
+		return span<char const>(m_hash_store->load(), m_hash_store->size);
+	}
+
+	bool torrent_info::load_piece_hashes_on_demand(info_section_loader loader
+		, bool const keep_loaded)
+	{
+		if (m_hash_store || !loader || !is_loaded() || m_orig_files) return false;
+		if (!m_info_hash.has_v1() || m_info_hash.has_v2()) return false;
+		if (m_piece_hashes <= 0) return false;
+
+		// "pieces" is a bencoded string: "<length>:<hashes>"
+		std::int64_t const hash_bytes = std::int64_t(num_pieces()) * 20;
+		std::string const header = std::to_string(hash_bytes) + ":";
+		int const hashes_begin = m_piece_hashes;
+		std::int64_t const hashes_end = hashes_begin + hash_bytes;
+		int const header_begin = hashes_begin - int(header.size());
+		if (header_begin <= 0 || hashes_end > m_info_section_size) return false;
+		char const* const full = m_info_section.get();
+		if (std::memcmp(full + header_begin, header.data(), header.size()) != 0)
+			return false;
+
+		// the in-memory info section keeps everything but the hashes, which become
+		// an empty string, so it still parses (info(), ssl_cert())
+		int const removed = int(hashes_end) - header_begin - 2;
+		int const compact_size = m_info_section_size - removed;
+		boost::shared_array<char> compact(new char[std::size_t(compact_size)]);
+		std::memcpy(compact.get(), full, std::size_t(header_begin));
+		std::memcpy(compact.get() + header_begin, "0:", 2);
+		std::memcpy(compact.get() + header_begin + 2, full + hashes_end
+			, std::size_t(m_info_section_size - hashes_end));
+
+		// file names (and file hashes) come before "pieces" in the info dictionary
+		if (!m_files.rebase_borrowed_pointers(full, full + m_info_section_size
+			, header_begin, compact.get()))
+		{
+			return false;
+		}
+		// "similar" sorts after "pieces"
+		for (auto& st : m_similar_torrents)
+			if (st >= hashes_end) st -= removed;
+		for (auto& c : m_collections)
+			if (c.first >= hashes_end) c.first -= removed;
+
+		m_hash_store = std::make_shared<aux::piece_hash_store>(std::move(loader)
+			, m_info_hash, m_info_section_size, hashes_begin, num_pieces());
+		if (keep_loaded)
+		{
+			m_hash_store->section = m_info_section;
+			m_hash_store->last_used = clock_type::now();
+		}
+
+		m_info_dict = bdecode_node();
+		m_info_section = std::move(compact);
+		m_info_section_size = compact_size;
+		m_piece_hashes = 0;
+		return true;
+	}
+
+	bool torrent_info::release_unused_piece_hashes(time_duration const idle) const
+	{
+		if (!m_hash_store) return false;
+		std::lock_guard<std::mutex> l(m_hash_store->mutex);
+		auto& store = *m_hash_store;
+		store.retired.reset();
+		if (!store.section) return false;
+		time_duration const effective_idle = idle * (1 << store.backoff);
+		time_point const now = clock_type::now();
+		if (now - store.last_used < effective_idle) return false;
+		store.retired = std::move(store.section);
+		store.section.reset();
+		store.released_at = now;
+		store.released_idle = effective_idle;
+		return true;
+	}
+
+	int torrent_info::info_section_size() const
+	{
+		return m_hash_store ? m_hash_store->size : m_info_section_size;
+	}
+
+	bool torrent_info::piece_hashes_loaded() const
+	{
+		if (!m_hash_store) return true;
+		std::lock_guard<std::mutex> l(m_hash_store->mutex);
+		return bool(m_hash_store->section);
+	}
 
 	void torrent_info::copy_on_write()
 	{
@@ -1093,8 +1262,9 @@ namespace {
 
