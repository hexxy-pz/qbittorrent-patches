+std::vector<char> make_v1_torrent(int const num_files)
+{
+	file_storage fs;
+	for (int i = 0; i < num_files; ++i)
+		fs.add_file("test/file-" + std::to_string(i), 0x4000 * 3 + 100 * i);
+	lt::create_torrent t(fs, 0x4000, create_torrent::v1_only);
+	for (auto const i : fs.piece_range())
+	{
+		sha1_hash h;
+		for (int k = 0; k < 20; ++k) h[std::size_t(k)] = std::uint8_t(static_cast<int>(i) * 7 + k);
+		t.set_hash(i, h);
+	}
+#ifndef TORRENT_DISABLE_MUTABLE_TORRENTS
+	t.add_similar_torrent(sha1_hash("abababababababababab"));
+	t.add_collection("collection-1");
+#endif
+	std::vector<char> buf;
+	bencode(std::back_inserter(buf), t.generate());
+	return buf;
+}
+
+std::vector<char> copy_section(torrent_info const& ti)
+{
+	auto const s = ti.info_section();
+	return {s.begin(), s.end()};
+}
